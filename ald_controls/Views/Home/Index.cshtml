@{
    ViewData["Title"] = "Home Page";
}



<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh; background: linear-gradient(120deg, #f8fafc 0%, #e3eafc 100%);">
    <div class="card shadow-lg border-0 p-5" style="max-width: 600px; width: 100%; border-radius: 22px; background: #fff;">
        <div class="text-center mb-4">
            <img src="/img/logo.ald.png" alt="Logo ALD Controls" style="max-width: 120px; border-radius: 12px; box-shadow: 0 2px 8px rgba(31, 38, 135, 0.10);" />
        </div>
        <h1 class="fw-bold mb-3" style="color: #1a237e; font-size: 2.4em;"><i class="bi bi-lightning-charge-fill"></i> Bem-vindo à ALD Controls</h1>
        <p class="lead mb-4" style="color: #333;">
            <strong>ALD Controls</strong> é referência em soluções inovadoras para automação e controle industrial.<br>
            Este portal foi criado para facilitar o gerenciamento de <span class="fw-bold text-primary">colaboradores</span>, <span class="fw-bold text-primary">EPIs</span> e <span class="fw-bold text-primary">registros</span>, promovendo segurança, organização e eficiência.<br><br>
            Nosso objetivo é oferecer uma experiência confiável e intuitiva para nossos clientes e parceiros.<br>
            <span class="text-secondary">Explore nossos recursos e conheça mais sobre nosso compromisso com a excelência!</span>
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/Colaboradores" class="btn btn-primary btn-lg shadow-sm"><i class="bi bi-people-fill"></i> Colaboradores</a>
            <a href="/Epis" class="btn btn-success btn-lg shadow-sm"><i class="bi bi-shield-check"></i> EPIs</a>
            <a href="/RegistroEpis" class="btn btn-warning btn-lg shadow-sm"><i class="bi bi-journal-check"></i> Registros</a>
        </div>
    </div>
</div>
<!-- Bootstrap Icons CDN (caso não tenha no projeto) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
