@model IEnumerable<ald_controls.Models.Colaborador>

@{
    ViewData["Title"] = "Index";
}


<div class="mb-3">
    <a href="/" class="btn btn-outline-primary"><i class="bi bi-house-door"></i> Voltar para Home</a>
</div>
<h1>Colaboradores</h1>
@if (User.IsInRole("Admin")) {
    <p>
        <a asp-action="Create" class="btn btn-primary">Adicionar Novo</a>
    </p>
}
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Setor)</th>
            @if (User.IsInRole("Admin")) {
                <th>Ações</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nome)</td>
            <td>@Html.DisplayFor(modelItem => item.Setor)</td>
            @if (User.IsInRole("Admin")) {
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
