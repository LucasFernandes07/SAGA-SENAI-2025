<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ald_controls</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ald_controls.styles.css" asp-append-version="true" />
 </head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
            <div class="container-fluid">
                <a class="navbar-brand site-navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/logo.ald.png" alt="Logo" style="height:40px; margin-right:10px; vertical-align:middle;" />
                    ALD Controls
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Colaboradores" asp-action="Index">Colaboradores</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Epis" asp-action="Index">Cadastrar EPIs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="RegistroEpis" asp-action="Index">Registro de EPIs</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Colaboradores" asp-action="Ranking">Ranking</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3" style="background: linear-gradient(90deg, #f8fafc 0%, #e3eafc 100%); border-top: 2px solid #e0e0e0;">
        <div class="container text-center">
            <span class="fw-bold" style="color:#1a237e; font-size:1.1em;">
                <i class="bi bi-shield-check"></i> &copy; 2025 - ALD Controls
            </span>
            <span class="mx-2">|</span>
            <a asp-area="" asp-controller="Colaboradores" asp-action="Ranking" class="text-decoration-none" style="color:#3949ab; font-weight:500;">
                <i class="bi bi-trophy"></i> Ranking dos Colaboradores
            </a>
        </div>
    </footer>
    <!-- Bootstrap Icons CDN (caso não tenha no projeto) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
